{
  "name": "@zetrix/openclaw-channel-whatsapp-evo",
  "version": "0.1.0",
  "description": "OpenClaw channel plugin for the EVO platform (Evolution API) — receives EVO-standardized WhatsApp messages, answers through the agent runtime, and sends replies back via EVO.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChihiroAF/openclaw-channel-whatsapp-evo.git"
  },
  "homepage": "https://github.com/ChihiroAF/openclaw-channel-whatsapp-evo#readme",
  "bugs": {
    "url": "https://github.com/ChihiroAF/openclaw-channel-whatsapp-evo/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./api.js": "./api.ts",
    "./runtime-api.js": "./runtime-api.ts"
  },
  "files": [
    "index.ts",
    "api.ts",
    "runtime-api.ts",
    "setup-entry.ts",
    "src/",
    "dist/",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noCheck",
    "build:checked": "tsc -p tsconfig.build.json",
    "build:pure": "tsc -p tsconfig.pure.json",
    "test": "npm run build:pure && node --test \"dist-pure/src/__tests__/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "verify:sdk": "node scripts/verify-sdk-symbols.mjs",
    "verify:legacy": "node scripts/check-no-legacy-refs.mjs",
    "verify:imports": "node scripts/check-relative-imports.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:lockfile": "node scripts/check-lockfile-registry.mjs",
    "verify:exports": "node scripts/check-relative-exports.mjs",
    "verify": "npm run verify:sdk && npm run verify:manifest && npm run verify:exports && npm run verify:legacy && npm run verify:imports && npm run verify:lockfile"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "whatsapp-evo",
      "label": "WhatsApp (via EVO)",
      "selectionLabel": "WhatsApp (via EVO)",
      "docsPath": "/channels/whatsapp-evo",
      "docsLabel": "whatsapp-evo",
      "blurb": "WhatsApp through the EVO platform (Evolution API): EVO handles Meta verification, dedupe and delivery; this plugin answers customer messages with the agent.",
      "order": 77
    }
  }
}
